# Copiar a .env y completar los valores requeridos con secretos propios.
# No reutilizar este archivo como configuracion real de produccion.

# Aplicacion y autenticacion JWT (requerido)
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
LOG_LEVEL=INFO

# PostgreSQL (requerido)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Compose deriva DATABASE_URL de las variables anteriores y entrega la clave
# mediante PGPASSWORD. Para ejecutar el backend fuera de Compose, completar:
# DATABASE_URL=postgresql+psycopg://<usuario>:<contrasena>@db:5432/<base>
DATABASE_URL=

# Pruebas: base aislada, distinta de DATABASE_URL y con nombre terminado en _test.
# No debe apuntar a produccion ni a la base demostrativa.
TEST_DATABASE_URL=

# Gemini (GEMINI_API_KEY es requerida por la configuracion de produccion)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# MCP HTTP. Las credenciales demo son opcionales y solo corresponden al fallback stdio.
# Dejarlas vacias en un despliegue HTTP; no usar credenciales de ejemplo.
MCP_DEMO_EMAIL=
MCP_DEMO_PASSWORD=
MCP_ISSUER_URL=http://127.0.0.1:8000
MCP_RESOURCE_URL=http://127.0.0.1:8000/mcp

# Carga controlada de datos demostrativos (solo para ejecutar el script de carga).
SEED_USER_EMAIL=

# Docker Compose de produccion (valores no secretos).
BACKEND_IMAGE=itca-tic-inventario-backend:production
BACKEND_ENV_FILE=.env
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
